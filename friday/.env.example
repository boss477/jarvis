# Copy to friday/.env only if you do not already have a config file.
# If friday/.env exists, merge the needed values into it; do not replace it.

# Local or OpenAI-compatible model used by the agent planner.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=
LLM_API_KEY=local

# Meta WhatsApp Cloud API. Obtain these from your WhatsApp Business app setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Comma-separated trusted WhatsApp phone numbers in international format.
WHATSAPP_ALLOWED_SENDERS=

# Keep the webhook bound to loopback; publish only through HTTPS reverse proxy.
AGENT_WEBHOOK_HOST=127.0.0.1
AGENT_WEBHOOK_PORT=8767
WHATSAPP_PROXY_HOST=127.0.0.1
WHATSAPP_PROXY_PORT=8769
AGENT_TASKS_PATH=agent-state/tasks.jsonl
